---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThreadCard from "../components/ThreadCard.astro";
import Sidebar from "../components/Sidebar.astro";

const threads = [
    {
        title: "Los reintentos no son una estrategia de resiliencia",
        href: "/t/reintentos",
        author: "@maya",
        authorInitials: "MC",
        time: "hace 2 h",
        excerpt:
            "Añadimos backoff exponencial y aun así tumbamos el servicio de pagos. Esto es lo que finalmente funcionó: reintentos acotados, jitter y un presupuesto de reintentos compartido.",
        comments: 3,
        category: "Ingeniería",
        visibility: "PUBLIC" as const,
    },
    {
        title: "SQLite en producción: ¿qué te sorprendió?",
        href: "/t/sqlite-produccion",
        author: "@owen",
        authorInitials: "OP",
        time: "hace 3 h",
        excerpt:
            "Estoy pasando un SaaS pequeño de Postgres a SQLite. Me encantaría saber dónde la simplicidad compensó y qué límites encontraron primero.",
        comments: 18,
        category: "Bases de datos",
        visibility: "PUBLIC" as const,
    },
    {
        title: "Una forma más tranquila de revisar código",
        href: "/t/revision-codigo",
        author: "@maya",
        authorInitials: "MC",
        time: "hace 5 h",
        excerpt:
            "Probando un nuevo ritual de revisión con el equipo esta semana. Comparto nuestra lista de verificación y algunas notas honestas antes de publicarlo más ampliamente.",
        comments: 7,
        category: "Ingeniería",
        visibility: "PRIVATE" as const,
    },
    {
        title: "Lo que dejé de abstraer en React",
        href: "/t/react-abstracciones",
        author: "@nina",
        authorInitials: "NS",
        time: "hace 6 h",
        excerpt:
            "No todo div repetido necesita un componente. Algunas lecciones de borrar 2.000 líneas de nuestro sistema de diseño sin cambiar la interfaz.",
        comments: 24,
        category: "Frontend",
        visibility: "PUBLIC" as const,
    },
    {
        title: "Construí una CLI pequeña para leer logs de servidor",
        href: "/t/cli-logs",
        author: "@eli",
        authorInitials: "EK",
        time: "hace 8 h",
        excerpt:
            "Sin panel, sin cuenta, solo lo último que se rompió. Comparto la primera versión de tailwinded, una herramienta pequeña en Rust para depurar en local.",
        comments: 12,
        category: "Demos",
        visibility: "PUBLIC" as const,
    },
];

const filters = [
    "Todos",
    "Solo públicos",
    "Ingeniería",
    "Frontend",
    "Etiquetas",
];
---

<BaseLayout title="Inicio">
    <main class="main">
        <div class="page-intro">
            <div>
                <h1>Buenas conversaciones empiezan aquí.</h1>
                <p>Preguntas, ideas y lecciones de personas que construyen.</p>
            </div>
        </div>

        <div class="two-col">
            <section aria-label="Hilos recientes">
                <div class="toolbar">
                    <div class="chips" role="group" aria-label="Filtrar hilos">
                        {filters.map((f, i) => (
                            <button
                                type="button"
                                class="chip"
                                aria-pressed={i === 0 ? "true" : "false"}
                            >
                                {f}
                            </button>
                        ))}
                    </div>
                </div>

                <div class="toolbar" style="margin-top: 0">
                    <h2 class="sort-label">Hilos más recientes</h2>
                    <button type="button" class="link-action">
                        Más nuevos primero
                    </button>
                </div>

                <div class="feed">
                    {threads.map((t) => (
                        <ThreadCard {...t} />
                    ))}
                </div>

                <button type="button" class="btn load-more">
                    Cargar más hilos
                </button>
            </section>

            <Sidebar />
        </div>

        <footer class="footer-links">
            <a href="/about">Acerca de</a>
            <span aria-hidden="true">·</span>
            <a href="/guidelines">Pautas</a>
            <span aria-hidden="true">·</span>
            <a href="/privacy">Privacidad</a>
            <span>© 2026 LogCod</span>
        </footer>
    </main>
</BaseLayout>
