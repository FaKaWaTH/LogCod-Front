---
import BaseLayout from "../layouts/BaseLayout.astro";

const categories = [
    "Ingeniería",
    "Frontend",
    "Bases de datos",
    "DevOps",
    "Demos",
    "Carrera",
];
---

<BaseLayout title="Nuevo hilo">
    <Fragment slot="head">
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css"
        />
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"
        >
            import { actions } from "astro:actions";
        </script>
    </Fragment>

    <main class="main">
        <div class="profile-narrow">
            <div class="page-intro">
                <div>
                    <h1>Crear hilo</h1>
                    <p>
                        Comparte una pregunta, una idea o una lección aprendida.
                    </p>
                </div>
            </div>

            <form
                class="auth-form"
                action="/api/threads"
                method="post"
                style="gap: var(--space-6)"
            >
                <div class="field">
                    <label class="field-label" for="thread-title">
                        Título
                    </label>
                    <input
                        id="thread-title"
                        name="title"
                        type="text"
                        class="input"
                        style="height: 3rem; font-size: 1.125rem; font-weight: 600"
                        placeholder="Un título útil para el hilo"
                        required
                    />
                </div>

                <div class="field">
                    <label class="field-label" for="thread-category">
                        Categoría
                    </label>
                    <select id="thread-category" name="category" class="select">
                        {categories.map((c) => (
                            <option>{c}</option>
                        ))}
                    </select>
                </div>

                <fieldset class="field" style="border:0;padding:0;margin:0">
                    <legend
                        class="field-label"
                        style="margin-bottom: var(--space-2)"
                    >
                        Visibilidad
                    </legend>
                    <div class="visibility">
                        <label class="visibility-option">
                            <input
                                type="radio"
                                name="visibility"
                                value="public"
                                checked
                            />
                            <span>
                                <span
                                    class="visibility-title"
                                    style="display:block"
                                >
                                    Público
                                </span>
                                <span class="visibility-desc">
                                    Todos pueden ver este hilo.
                                </span>
                            </span>
                        </label>
                        <label class="visibility-option">
                            <input
                                type="radio"
                                name="visibility"
                                value="private"
                            />
                            <span>
                                <span
                                    class="visibility-title"
                                    style="display:block"
                                >
                                    Privado
                                </span>
                                <span class="visibility-desc">
                                    Solo lo ven tus amigos confirmados.
                                </span>
                            </span>
                        </label>
                    </div>
                </fieldset>

                <div class="field">
                    <label class="field-label" for="thread-body">
                        Contenido
                    </label>
                    <textarea id="thread-body" name="body"></textarea>
                </div>

                <div class="thread-actions" style="justify-content: flex-end">
                    <a href="/" class="btn btn--ghost">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn--primary">
                        Publicar hilo
                    </button>
                </div>
            </form>
        </div>
    </main>
</BaseLayout>

<script is:inline>
    new EasyMDE({
        element: document.getElementById("thread-body"),
        spellChecker: false,
        status: false,
        minHeight: "300px",
        placeholder: "Escribe en Markdown...",
        toolbar: [
            "bold",
            "italic",
            "heading",
            "|",
            "quote",
            "unordered-list",
            "ordered-list",
            "|",
            "link",
            "code",
            "|",
            "preview",
            "side-by-side",
            "fullscreen",
            "|",
            "guide",
        ],
    });
</script>
